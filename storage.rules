rules_version = '2';

// Passport photos and event cover images. Mirrors the `accounts` /
// `client` permission checks in firestore.rules, via the cross-service
// firestore.get() call Storage rules support.
service firebase.storage {
  match /b/{bucket}/o {

    function myPerms() {
      let person = firestore.get(/databases/(default)/documents/people/$(request.auth.uid)).data;
      let role = firestore.get(/databases/(default)/documents/roles/$(person.roleId)).data;
      return person.active == true ? role.perms : [];
    }

    match /people/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && ('accounts' in myPerms() || request.auth.uid == uid);
    }

    match /events/{eventId}/{fileName} {
      // Cover images are shown on the public client portal, so they're
      // world-readable — same tradeoff as the event doc itself.
      allow read: if true;
      allow write: if request.auth != null && ('client' in myPerms() || 'accounts' in myPerms());
    }
  }
}
